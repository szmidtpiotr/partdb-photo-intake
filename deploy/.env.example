# Copy to .env (same directory as docker-compose.yml) and fill in.
# .env holds secrets — never commit it.

# --- Part-DB ---
# Random secret for Part-DB sessions. Generate one with:  openssl rand -hex 32
PARTDB_APP_SECRET=

# Password for the Part-DB "admin" account, set when the database is created.
PARTDB_ADMIN_PASSWORD=

# Host names Part-DB accepts, as a regular expression (dots escaped).
# Keep "partdb" and "localhost"; add the IP address of your server and the
# domain you use for HTTPS. Single quotes matter: they stop Docker Compose
# from interpreting the "$" at the end.
PARTDB_TRUSTED_HOSTS='^(partdb|localhost|192\.168\.1\.50|partdb\.example\.com)$'

PARTDB_LANG=en
PARTDB_CURRENCY=EUR
TZ=Europe/Berlin

# --- bom-agent ---
# Part-DB API token with level EDIT (bom-agent writes parts and stock).
# Create it after the first start: Part-DB -> user menu -> User settings ->
# API tokens. Starts with tcp_.
PARTDB_API_TOKEN=

# Where a BROWSER reaches bom-agent and Part-DB. The phone camera only works
# over HTTPS, so for real use these are your HTTPS addresses.
PUBLIC_BASE_URL=https://intake.example.com
PARTDB_PUBLIC_URL=https://partdb.example.com

# Ports on the server (change if they are taken).
PARTDB_PORT=8090
BOM_AGENT_PORT=8091
