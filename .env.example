# For running bom-agent OUTSIDE Docker (development, tests against a live
# Part-DB). For the normal installation use deploy/.env.example instead.
#
#   cp .env.example .env && set -a && . ./.env && set +a
#   uv run python -m bom_agent

# Part-DB instance address, WITHOUT /api (the client adds it).
PARTDB_URL=http://localhost:8090
PARTDB_TIMEOUT=10

# Part-DB API token, level EDIT or higher (bom-agent writes to the inventory).
PARTDB_API_TOKEN=

# Local paths for the intake queue and photos.
BOM_DB_PATH=./data/bom.db
INTAKE_PHOTO_DIR=./data/intake/photos
LOG_LEVEL=INFO

# Addresses a browser uses to reach bom-agent and Part-DB.
PUBLIC_BASE_URL=http://localhost:8091
PARTDB_PUBLIC_URL=http://localhost:8090
